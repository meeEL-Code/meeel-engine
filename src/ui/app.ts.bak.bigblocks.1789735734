  { group: 'Font sizes', name: 'font-small', description: 'Small text (13px)', value: 'font-small' },
  { group: 'Font sizes', name: 'font-medium', description: 'Medium text (16px)', value: 'font-medium' },
  { group: 'Font sizes', name: 'font-large', description: 'Large text (24px)', value: 'font-large' },
  { group: 'Font sizes', name: 'font-huge', description: 'Very large text (48px)', value: 'font-huge' },
  { group: 'Font sizes', name: 'font-massive', description: 'Huge text (72px)', value: 'font-massive' },

  // ── Gaps ──
