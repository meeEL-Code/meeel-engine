* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: #1e1e1e;
  color: #e0e0e0;
  height: 100vh;
  height: 100dvh;
  display: flex;
  flex-direction: column;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  background: #252526;
  border-bottom: 1px solid #333;
}

.logo {
  font-weight: 600;
  font-size: 17px;
  letter-spacing: 0.3px;
  color: #f0f0f0;
}

.btn-publish {
  background: #0a84ff;
  color: white;
  border: none;
  padding: 7px 14px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
}

.btn-publish:hover { background: #0070e0; }

.layout {
  flex: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  background: #333;
  overflow: hidden;
}

@media (max-width: 700px) {
  .layout { grid-template-columns: 1fr; grid-template-rows: 1fr 1fr; }
}

.pane {
  background: #1e1e1e;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.pane-header {
  padding: 6px 12px;
  background: #252526;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: #777;
  border-bottom: 1px solid #333;
}

/* === Editor container with gutter === */
.editor-container {
  flex: 1;
  display: flex;
  overflow: hidden;
  background: #1e1e1e;
}

.gutter {
  flex-shrink: 0;
  width: 38px;
  padding: 14px 8px 14px 4px;
  background: #1a1a1a;
  color: #555;
  text-align: right;
  font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 12px;
  line-height: 1.6;
  overflow: hidden;
  user-select: none;
  border-right: 1px solid #262626;
}

.gutter .ln {
  display: block;
  position: relative;
}

.gutter .ln.has-error {
  color: #ff6b6b;
  font-weight: 600;
}

.gutter .ln.has-error::before {
  content: '';
  position: absolute;
  left: -6px;
  top: 50%;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #ff4d4d;
  transform: translateY(-50%);
}

.editor-wrap {
  position: relative;
  flex: 1;
  overflow: hidden;
  background: #1e1e1e;
}

/* === SHARED FONT STYLE — MUST MATCH === */
.editor-highlight,
#editor {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  padding: 14px 16px;
  margin: 0;
  border: none;
  outline: none;

  font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, "Liberation Mono", "Courier New", monospace;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.6;
  letter-spacing: 0.01em;

  white-space: pre-wrap;
  word-wrap: break-word;
  overflow-wrap: break-word;
  overflow: auto;
  tab-size: 2;

  -webkit-text-size-adjust: 100%;
  text-rendering: geometricPrecision;
  -webkit-font-smoothing: antialiased;
}

.editor-highlight {
  pointer-events: none;
  z-index: 1;
  color: #d4d4d4;
  background: #1e1e1e;
}

#editor {
  z-index: 2;
  background: transparent;
  color: transparent;
  -webkit-text-fill-color: transparent;
  caret-color: #4fc1ff;
  resize: none;
  -webkit-appearance: none;
  appearance: none;
  font-variant-ligatures: none;
}

/* === Syntax colors === */
.tok-block      { color: #4fc1ff; font-weight: 600; }
.tok-property   { color: #7ec699; font-weight: 500; }
.tok-keyword    { color: #f0a868; font-weight: 500; }
.tok-bracket    { color: #6b7280; }
.tok-value      { color: #e8a5a5; }

/* === Error underline — ONLY on offending token === */
.tok-error {
  text-decoration: underline wavy #ff4d4d;
  text-decoration-thickness: 1.5px;
  text-underline-offset: 4px;
  background: rgba(255, 77, 77, 0.12);
  border-radius: 2px;
}

#preview {
  flex: 1;
  border: none;
  background: white;
  width: 100%;
}

/* === Selection: semi-transparent so syntax colors show through === */
#editor::selection {
  background: rgba(79, 193, 255, 0.28);
  color: transparent;
  -webkit-text-fill-color: transparent;
}

#editor::-moz-selection {
  background: rgba(79, 193, 255, 0.28);
  color: transparent;
  -webkit-text-fill-color: transparent;
}

.editor-highlight::selection {
  background: transparent;
}

/* Suggestion icon (SVG) */
.sugg-icon {
  flex-shrink: 0;
  color: #86efac;
  opacity: 0.9;
}

/* SVG icon helpers */
.sugg-icon {
  display: inline-flex;
  flex-shrink: 0;
  color: #86efac;
}

/* ============ Autocomplete suggestion bar ============ */
.suggestion-bar {
  display: flex;
  flex-wrap: nowrap;
  gap: 6px;
  padding: 8px 12px;
  background: #252526;
  border-top: 1px solid #333;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: thin;
  scrollbar-color: #444 transparent;
}

.suggestion-bar::-webkit-scrollbar {
  height: 4px;
}
.suggestion-bar::-webkit-scrollbar-thumb {
  background: #444;
  border-radius: 2px;
}

.sugg-item {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
  padding: 6px 10px;
  background: #2f2f2f;
  color: #d0d0d0;
  border: 1px solid #3a3a3a;
  border-radius: 5px;
  font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.12s ease, border-color 0.12s ease;
  user-select: none;
  white-space: nowrap;
}

.sugg-item:hover,
.sugg-item.active {
  background: #3a3a3a;
  border-color: #555;
}

.sugg-item .sugg-cat {
  display: inline-block;
  font-size: 9px;
  font-weight: 700;
  padding: 2px 5px;
  border-radius: 3px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.sugg-cat.block    { background: #1e3a5f; color: #7ec699; }
.sugg-cat.property { background: #2d4a2d; color: #a5e8a5; }
.sugg-cat.keyword  { background: #5a3f1e; color: #ffb87a; }

.sugg-name {
  color: #e0e0e0;
}

.sugg-hint {
  color: #666;
  font-size: 10px;
  margin-left: auto;
  padding-left: 12px;
}

/* Save indicator */
.topbar-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.save-indicator {
  font-size: 11px;
  color: #777;
  font-family: ui-monospace, monospace;
  letter-spacing: 0.02em;
  opacity: 0;
  transition: opacity 0.3s ease;
  user-select: none;
}

/* ============ Publish Modal — Premium ============ */

.btn-publish {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  padding: 0;
  background: #0a84ff;
  color: white;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.15s ease, transform 0.1s ease;
}
.btn-publish:hover { background: #0070e0; }
.btn-publish:active { transform: scale(0.94); }

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.72);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
  padding-top: max(20px, env(safe-area-inset-top, 20px));
  padding-bottom: max(20px, env(safe-area-inset-bottom, 20px));
  overflow-y: auto;
  animation: fadeIn 0.18s ease;
}

.modal-backdrop[hidden] { display: none; }

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes slideUp { from { opacity: 0; transform: translateY(12px) scale(0.98); } to { opacity: 1; transform: translateY(0) scale(1); } }

.modal {
  background: #1a1a1a;
  border: 1px solid #2a2a2a;
  border-radius: 14px;
  width: 100%;
  max-width: 760px;
  max-height: calc(100vh - 40px);
  max-height: calc(100dvh - 40px);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 24px 72px rgba(0, 0, 0, 0.6), 0 8px 24px rgba(0, 0, 0, 0.4);
  animation: slideUp 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
  margin: 0 auto;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid #242424;
  background: linear-gradient(180deg, #202020 0%, #1a1a1a 100%);
}

.modal-header-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.modal-brand {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 700;
  color: #f5f5f5;
  letter-spacing: 0.02em;
}

.modal-brand-accent {
  color: #0a84ff;
}

.modal-subtitle {
  font-size: 11px;
  color: #666;
  letter-spacing: 0.03em;
  padding-left: 10px;
  border-left: 1px solid #333;
  font-weight: 500;
}

.modal-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  background: transparent;
  color: #888;
  border: none;
  border-radius: 7px;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}
.modal-close:hover { background: #2a2a2a; color: #e0e0e0; }

.modal-tabs {
  display: flex;
  gap: 2px;
  padding: 6px 16px 0 16px;
  border-bottom: 1px solid #242424;
  background: #1a1a1a;
}

.modal-tab {
  padding: 10px 16px;
  background: transparent;
  color: #777;
  border: none;
  border-bottom: 2px solid transparent;
  font-size: 11px;
  font-weight: 700;
  font-family: ui-monospace, monospace;
  letter-spacing: 0.08em;
  cursor: pointer;
  transition: color 0.15s ease, border-color 0.15s ease;
  margin-bottom: -1px;
}
.modal-tab:hover { color: #c0c0c0; }
.modal-tab.active {
  color: #0a84ff;
  border-bottom-color: #0a84ff;
}

.modal-body {
  flex: 1;
  overflow: hidden;
  display: flex;
  background: #141414;
}

.code-wrap {
  position: relative;
  flex: 1;
  overflow: auto;
  background: #141414;
  scrollbar-width: thin;
  scrollbar-color: #333 transparent;
}

.code-wrap::-webkit-scrollbar { width: 10px; height: 10px; }
.code-wrap::-webkit-scrollbar-track { background: transparent; }
.code-wrap::-webkit-scrollbar-thumb { background: #2a2a2a; border-radius: 5px; }
.code-wrap::-webkit-scrollbar-thumb:hover { background: #3a3a3a; }

.copy-btn {
  position: absolute;
  top: 12px;
  right: 12px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 11px;
  background: #242424;
  color: #b0b0b0;
  border: 1px solid #333;
  border-radius: 6px;
  font-size: 11px;
  font-family: inherit;
  font-weight: 600;
  letter-spacing: 0.02em;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  z-index: 10;
}
.copy-btn:hover { background: #2e2e2e; color: #e0e0e0; border-color: #444; }
.copy-btn.copied { background: #16a34a; color: white; border-color: #16a34a; }

#modal-code {
  padding: 46px 20px 20px 20px;
  font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 12px;
  line-height: 1.6;
  color: #d4d4d4;
  white-space: pre;
  tab-size: 2;
  min-width: 100%;
  width: max-content;
}

.modal-footer {
  display: flex;
  gap: 8px;
  justify-content: flex-end;
  align-items: center;
  padding: 12px 16px;
  border-top: 1px solid #242424;
  background: #1a1a1a;
}

.modal-footer-hint {
  margin-right: auto;
  font-size: 11px;
  color: #555;
  font-style: italic;
  padding-left: 4px;
}

@media (max-width: 520px) {
  .modal-footer-hint { display: none; }
  .modal-footer { flex-wrap: wrap; }
  .btn-secondary, .btn-primary { flex: 1; justify-content: center; font-size: 11.5px; padding: 8px 10px; }
}

.btn-secondary,
.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 9px 15px;
  border: none;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 600;
  font-family: inherit;
  letter-spacing: 0.01em;
  cursor: pointer;
  transition: background 0.15s ease, transform 0.1s ease;
}

.btn-secondary {
  background: #242424;
  color: #c0c0c0;
  border: 1px solid #333;
}
.btn-secondary:hover { background: #2e2e2e; color: #e0e0e0; }
.btn-secondary:active { transform: scale(0.97); }

.btn-primary {
  background: #0a84ff;
  color: white;
  box-shadow: 0 1px 0 rgba(255, 255, 255, 0.1) inset;
}
.btn-primary:hover { background: #0070e0; }
.btn-primary:active { transform: scale(0.97); }

/* ============ Page selector ============ */
.pane-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-selector {
  background: #2a2a2a;
  color: #d0d0d0;
  border: 1px solid #3a3a3a;
  border-radius: 5px;
  padding: 3px 8px;
  font-size: 11px;
  font-family: ui-monospace, monospace;
  font-weight: 600;
  cursor: pointer;
  outline: none;
  margin: 0;
}

.page-selector:hover {
  background: #333;
  border-color: #444;
}

.page-selector[hidden] {
  display: none;
}

/* ============ Import Button ============ */
.btn-import {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  padding: 0;
  background: #2a2a2a;
  color: #c0c0c0;
  border: 1px solid #3a3a3a;
  border-radius: 8px;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
}
.btn-import:hover {
  background: #333;
  color: #e0e0e0;
  border-color: #4a4a4a;
}
.btn-import:active {
  transform: scale(0.94);
}

/* ============ Drag & Drop Overlay ============ */
.editor-container {
  position: relative;
}
.drop-overlay {
  position: absolute;
  inset: 0;
  background: rgba(10, 132, 255, 0.12);
  border: 2px dashed #0a84ff;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8px;
  z-index: 100;
  pointer-events: none;
  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  color: #0a84ff;
  font-size: 14px;
  font-weight: 600;
  opacity: 0;
  transition: opacity 0.15s ease;
}
.drop-overlay.active {
  opacity: 1;
}
.drop-overlay-icon {
  font-size: 28px;
  line-height: 1;
}
.drop-overlay-text {
  text-align: center;
}

/* Comment syntax */
.tok-comment {
  color: #6b7f6b;
  font-style: italic;
}

/* ============ Preview Controls ============ */
.preview-controls {
  display: flex;
  align-items: center;
  gap: 8px;
}

.btn-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  padding: 0;
  background: transparent;
  color: #888;
  border: none;
  border-radius: 5px;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}
.btn-icon:hover {
  background: #3a3a3a;
  color: #d0d0d0;
}
.btn-icon:active {
  transform: scale(0.92);
}

/* ============ Preview Fullscreen ============ */
.preview-pane:fullscreen {
  width: 100vw;
  height: 100vh;
  background: #ffffff;
  border-radius: 0;
}
.preview-pane:-webkit-full-screen {
  width: 100vw;
  height: 100vh;
  background: #ffffff;
  border-radius: 0;
}
.preview-pane:fullscreen .pane-header {
  background: #f5f5f5;
  color: #333;
  border-bottom: 1px solid #e0e0e0;
}
.preview-pane:fullscreen .pane-header span,
.preview-pane:fullscreen .btn-icon {
  color: #666;
}
.preview-pane:fullscreen .btn-icon:hover {
  background: #e0e0e0;
  color: #000;
}
.preview-pane:fullscreen iframe {
  width: 100%;
  height: 100%;
  flex: 1;
}

/* Fallback fullscreen (when native API not available) */
.preview-pane.fallback-fullscreen {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  width: 100vw !important;
  height: 100vh !important;
  z-index: 5000 !important;
  background: #ffffff !important;
  border-radius: 0 !important;
}
.preview-pane.fallback-fullscreen iframe {
  width: 100% !important;
  height: 100% !important;
  flex: 1;
}

/* Logo with icon */
.logo {
  display: flex;
  align-items: center;
  gap: 8px;
}
.logo-icon {
  display: block;
  flex-shrink: 0;
}

/* ============ Install (PWA) Button ============ */
.btn-install {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  background: #0a84ff;
  color: white;
  border: none;
  border-radius: 8px;
  font-family: inherit;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.02em;
  cursor: pointer;
  transition: background 0.15s ease, transform 0.1s ease;
}
.btn-install:hover {
  background: #0070e0;
}
.btn-install:active {
  transform: scale(0.96);
}
.btn-install[hidden] {
  display: none;
}

/* ============================================================
   TV / Large Screen (1400px+)
   ============================================================ */

@media (min-width: 1400px) {
  body {
    font-size: 18px;
  }

  .topbar {
    padding: 16px 28px;
  }

  .logo {
    font-size: 24px;
    gap: 12px;
  }
  .logo-icon {
    width: 32px !important;
    height: 32px !important;
  }

  .save-indicator {
    font-size: 14px;
  }

  .btn-publish,
  .btn-import {
    width: 48px;
    height: 48px;
    border-radius: 10px;
  }

  .btn-publish svg,
  .btn-import svg {
    width: 24px;
    height: 24px;
  }

  .btn-install {
    padding: 10px 18px;
    font-size: 15px;
    border-radius: 10px;
  }
  .btn-install svg {
    width: 20px;
    height: 20px;
  }

  .pane-header {
    font-size: 14px;
    padding: 12px 20px;
    letter-spacing: 1.8px;
  }

  .gutter {
    width: 60px;
    padding: 20px 12px 20px 8px;
    font-size: 16px;
  }

  .editor-highlight,
  #editor {
    padding: 20px 24px;
    font-size: 18px;
    line-height: 1.7;
  }

  .sugg-item {
    font-size: 15px;
    padding: 10px 14px;
    border-radius: 8px;
  }
  .sugg-item .sugg-cat {
    font-size: 11px;
    padding: 3px 7px;
  }
  .suggestion-bar {
    padding: 12px 18px;
    gap: 10px;
  }

  .page-selector {
    font-size: 14px;
    padding: 6px 12px;
  }

  .btn-icon {
    width: 36px;
    height: 36px;
  }
  .btn-icon svg {
    width: 20px;
    height: 20px;
  }

  /* Modal */
  .modal {
    max-width: 1000px;
  }
  .modal-header {
    padding: 22px 28px;
  }
  .modal-brand {
    font-size: 20px;
  }
  .modal-subtitle {
    font-size: 14px;
    padding-left: 14px;
  }
  .modal-tab {
    padding: 14px 22px;
    font-size: 14px;
  }
  #modal-code {
    font-size: 15px;
    padding: 52px 28px 24px 28px;
  }
  .copy-btn {
    padding: 9px 16px;
    font-size: 14px;
  }
  .modal-close {
    width: 40px;
    height: 40px;
  }
  .modal-close svg {
    width: 22px;
    height: 22px;
  }
  .modal-footer {
    padding: 16px 22px;
  }
  .btn-secondary,
  .btn-primary {
    padding: 12px 20px;
    font-size: 15px;
  }
  .modal-footer-hint {
    font-size: 14px;
  }

  /* Errors */
  .err-card {
    padding: 20px 24px;
  }
  .line-chip {
    font-size: 14px;
    padding: 5px 12px;
  }
  .type-badge {
    font-size: 12px;
    padding: 5px 10px;
  }
  .err-msg {
    font-size: 16px;
  }
  .err-msg code {
    font-size: 15px;
  }
  .suggestion {
    padding: 12px 16px;
    font-size: 15px;
  }
  .fix-btn {
    padding: 8px 16px;
    font-size: 14px;
  }
}


/* ============================================================
   Tools Drawer
   ============================================================ */

.btn-tools {
  background: transparent;
  border: none;
  color: #b4b4bc;
  padding: 6px;
  cursor: pointer;
  border-radius: 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease, color 0.15s ease;
}
.btn-tools:hover {
  background: rgba(255, 255, 255, 0.06);
  color: #f0f0f3;
}

.tools-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 8999;
  -webkit-backdrop-filter: blur(2px);
  backdrop-filter: blur(2px);
}

.tools-drawer {
  position: fixed;
  top: 0;
  right: 0;
  width: 340px;
  max-width: 90vw;
  height: 100vh;
  background: #131316;
  border-left: 1px solid rgba(255, 255, 255, 0.06);
  z-index: 9000;
  transform: translateX(100%);
  transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  display: flex;
  flex-direction: column;
}
.tools-drawer.open {
  transform: translateX(0);
}

.tools-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
}
.tools-title {
  font-size: 18px;
  font-weight: 700;
  color: #f0f0f3;
  letter-spacing: -0.01em;
}
.tools-close {
  background: transparent;
  border: none;
  color: #b4b4bc;
  padding: 6px;
  cursor: pointer;
  border-radius: 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease, color 0.15s ease;
}
.tools-close:hover {
  background: rgba(255, 255, 255, 0.06);
  color: #f0f0f3;
}

.tools-body {
  flex: 1;
  overflow-y: auto;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.tools-body::-webkit-scrollbar { width: 6px; }
.tools-body::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 3px;
}

.tools-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 18px;
  background: #1a1a1e;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 14px;
  text-align: left;
  cursor: pointer;
  font-family: inherit;
  color: inherit;
  transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
}
.tools-card:hover {
  background: #212127;
  border-color: rgba(10, 132, 255, 0.35);
}
.tools-card:active {
  transform: scale(0.985);
}

.tools-card-icon {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(10, 132, 255, 0.12);
  border-radius: 12px;
  flex-shrink: 0;
  color: #4fc1ff;
}
.tools-card-icon svg {
  display: block;
}

.tools-card-text {
  flex: 1;
  min-width: 0;
}
.tools-card-title {
  font-size: 15px;
  font-weight: 700;
  color: #f0f0f3;
  margin-bottom: 3px;
  letter-spacing: -0.005em;
}
.tools-card-desc {
  font-size: 12px;
  color: #7a7a84;
  line-height: 1.35;
}

.tools-divider {
  height: 1px;
  background: rgba(255, 255, 255, 0.06);
  margin: 6px 4px;
}

.tools-card-settings {
  background: transparent;
  border-color: rgba(255, 255, 255, 0.04);
}
.tools-card-settings:hover {
  background: #1a1a1e;
  border-color: rgba(255, 255, 255, 0.08);
}
.tools-card-settings .tools-card-icon {
  background: rgba(255, 255, 255, 0.05);
  color: #b4b4bc;
}
.tools-card-settings .tools-card-title {
  color: #b4b4bc;
}

/* ============================================================
   Library Pages (Icons, Blocks, etc.)
   ============================================================ */

.lib-page {
  position: fixed;
  inset: 0;
  background: #0d0d0f;
  z-index: 9100;
  display: flex;
  flex-direction: column;
}

.lib-page-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
  background: #131316;
}
.lib-page-title {
  flex: 1;
  font-size: 18px;
  font-weight: 700;
  color: #f0f0f3;
  letter-spacing: -0.01em;
}
.lib-page-back,
.lib-page-close {
  background: transparent;
  border: none;
  color: #b4b4bc;
  padding: 8px;
  cursor: pointer;
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s ease, color 0.15s ease;
}
.lib-page-back:hover,
.lib-page-close:hover {
  background: rgba(255, 255, 255, 0.06);
  color: #f0f0f3;
}

.lib-page-search {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 20px;
  background: #131316;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
  color: #7a7a84;
}
.lib-page-search input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: #f0f0f3;
  font-family: inherit;
  font-size: 14px;
  padding: 4px 0;
}
.lib-page-search input::placeholder {
  color: #7a7a84;
}

.lib-page-body {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
}
.lib-page-body::-webkit-scrollbar { width: 6px; }
.lib-page-body::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 3px;
}

/* ── Icons Grid ── */
.icons-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 12px;
  max-width: 1200px;
  margin: 0 auto;
}

.icon-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16px 12px 12px;
  background: #1a1a1e;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;
  transition: background 0.15s ease, border-color 0.15s ease;
}
.icon-card:hover {
  background: #212127;
  border-color: rgba(10, 132, 255, 0.35);
}

.icon-card-visual {
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
  color: #4fc1ff;
}
.icon-card-visual svg {
  width: 32px;
  height: 32px;
  display: block;
}
.icon-card-visual svg path,
.icon-card-visual svg line,
.icon-card-visual svg polyline,
.icon-card-visual svg polygon,
.icon-card-visual svg circle,
.icon-card-visual svg rect {
  stroke: currentColor;
  fill: none;
}

.icon-card-name {
  font-size: 12px;
  font-weight: 600;
  color: #f0f0f3;
  margin-bottom: 4px;
  text-align: center;
  word-break: break-word;
}

.icon-card-code {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  color: #7a7a84;
  background: rgba(255, 255, 255, 0.04);
  padding: 3px 8px;
  border-radius: 4px;
  margin-bottom: 10px;
  text-align: center;
  word-break: break-all;
  max-width: 100%;
  line-height: 1.3;
}

.icon-card-copy {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: rgba(10, 132, 255, 0.12);
  border: 1px solid rgba(10, 132, 255, 0.28);
  color: #4fc1ff;
  font-family: inherit;
  font-size: 11px;
  font-weight: 700;
  padding: 5px 12px;
  border-radius: 6px;
  cursor: pointer;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  transition: background 0.15s ease, color 0.15s ease;
}
.icon-card-copy:hover {
  background: rgba(10, 132, 255, 0.24);
}
.icon-card-copy:active {
  transform: scale(0.96);
}
.icon-card-copy.copied {
  background: rgba(22, 163, 74, 0.2);
  border-color: rgba(22, 163, 74, 0.4);
  color: #86efac;
}

.icons-empty {
  text-align: center;
  padding: 60px 20px;
  color: #7a7a84;
  font-size: 14px;
}

/* Fix: hidden attribute must override display: flex */
.lib-page[hidden] {
  display: none !important;
}
